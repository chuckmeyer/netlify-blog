---
import BaseLayout from './BaseLayout.astro';
import RecipeBlock from '../components/RecipeBlock.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, heroImage, heroImageAlt, tags, ingredients, instructions, glass, garnish, spirit } = post.data;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`${title} | Cocktail Chronicles`} description={description} ogImage={heroImage} ogImageAlt={heroImageAlt}>
  <article class="max-w-3xl mx-auto px-4 py-12">

    <!-- Hero image -->
    {heroImage && (
      <div class="mb-8 rounded-xl overflow-hidden aspect-video">
        <img
          src={heroImage}
          alt={heroImageAlt ?? title}
          class="w-full h-full object-cover"
        />
      </div>
    )}

    <!-- Header -->
    <header class="mb-8">
      <div class="flex flex-wrap gap-2 mb-4">
        <span class="text-xs font-medium bg-amber-900/40 text-amber-300 px-2 py-1 rounded">
          {spirit}
        </span>
        <span class="text-xs font-medium bg-stone-800 text-stone-400 px-2 py-1 rounded">
          {glass}
        </span>
        {tags.map((tag) => (
          <span class="text-xs bg-stone-800 text-stone-400 px-2 py-1 rounded">
            #{tag}
          </span>
        ))}
      </div>
      <h1 class="text-4xl font-bold text-stone-50 mb-3">{title}</h1>
      <p class="text-lg text-stone-400 mb-4">{description}</p>
      <time class="text-sm text-stone-500" datetime={pubDate.toISOString()}>
        {formattedDate}
      </time>
    </header>

    <!-- Recipe block -->
    <RecipeBlock
      ingredients={ingredients}
      instructions={instructions}
      glass={glass}
      garnish={garnish}
    />

    <!-- Post body -->
    <div class="mt-10 prose prose-invert prose-stone prose-headings:text-stone-100 prose-a:text-amber-400 max-w-none">
      <slot />
    </div>

  </article>
</BaseLayout>
