---
import BaseLayout from './BaseLayout.astro';
import RecipeBlock from '../components/RecipeBlock.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, heroImage, heroImageAlt, tags, ingredients, instructions, glass, garnish, spirit } = post.data;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`${title} | Cocktail Chronicles`} description={description} ogImage={heroImage} ogImageAlt={heroImageAlt}>

  <!-- Post header band -->
  <div class="bg-charcoal text-cream py-12 px-4">
    <div class="max-w-3xl mx-auto">
      <div class="flex flex-wrap gap-2 mb-5">
        <span class="bg-mustard text-charcoal text-xs font-bold px-3 py-1 rounded-full">
          {spirit}
        </span>
        <span class="bg-white/10 text-cream text-xs font-semibold px-3 py-1 rounded-full">
          {glass}
        </span>
        {tags.map((tag) => (
          <span class="bg-white/10 text-cream/70 text-xs px-3 py-1 rounded-full">
            #{tag}
          </span>
        ))}
      </div>
      <h1 class="font-display text-5xl md:text-6xl text-cream leading-tight mb-4">{title}</h1>
      <p class="text-cream/70 text-lg mb-4 max-w-2xl">{description}</p>
      <time class="text-cream/40 text-sm font-medium" datetime={pubDate.toISOString()}>
        {formattedDate}
      </time>
    </div>
  </div>

  <article class="max-w-3xl mx-auto px-4 py-12">

    <!-- Hero image -->
    {heroImage && (
      <div class="mb-10 rounded-2xl overflow-hidden aspect-video shadow-md">
        <img
          src={heroImage}
          alt={heroImageAlt ?? title}
          class="w-full h-full object-cover"
        />
      </div>
    )}

    <!-- Recipe block -->
    <RecipeBlock
      ingredients={ingredients}
      instructions={instructions}
      glass={glass}
      garnish={garnish}
    />

    <!-- Post body -->
    <div class="mt-10 prose prose-stone prose-headings:text-charcoal prose-a:text-teal prose-a:no-underline hover:prose-a:underline max-w-none">
      <slot />
    </div>

  </article>
</BaseLayout>
