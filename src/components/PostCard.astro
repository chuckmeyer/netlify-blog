---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, heroImage, heroImageAlt, spirit, glass } = post.data;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<a
  href={`/blog/${post.id}`}
  class="group flex flex-col bg-white rounded-2xl overflow-hidden shadow-sm border border-parchment hover:-translate-y-1 hover:shadow-md transition-all duration-300"
>
  <!-- Hero image -->
  {heroImage && (
    <div class="aspect-video overflow-hidden">
      <img
        src={heroImage}
        alt={heroImageAlt ?? title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      />
    </div>
  )}

  <!-- Color bar -->
  <div class="h-1.5 bg-mustard w-full"></div>

  <div class="p-6 flex flex-col flex-1">
    <!-- Badges -->
    <div class="flex flex-wrap gap-2 mb-4">
      <span class="bg-coral text-white text-xs font-bold px-3 py-1 rounded-full">
        {spirit}
      </span>
      <span class="bg-teal-lt text-teal text-xs font-semibold px-3 py-1 rounded-full">
        {glass}
      </span>
    </div>

    <!-- Title -->
    <h2 class="font-display text-2xl text-charcoal mb-2 group-hover:text-coral transition-colors duration-200 leading-tight">
      {title}
    </h2>

    <!-- Description -->
    <p class="text-sm text-muted leading-relaxed line-clamp-3 flex-1 mb-4">
      {description}
    </p>

    <!-- Date + CTA -->
    <div class="flex items-center justify-between mt-auto pt-4 border-t border-parchment">
      <time class="text-xs text-muted/70 font-medium" datetime={pubDate.toISOString()}>
        {formattedDate}
      </time>
      <span class="text-xs font-bold text-coral group-hover:translate-x-0.5 transition-transform duration-200">
        Recipe →
      </span>
    </div>
  </div>
</a>
