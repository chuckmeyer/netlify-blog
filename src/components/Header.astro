---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/blog', label: 'Recipes' },
];
---

<header class="bg-cream/95 backdrop-blur-sm border-b-4 border-mustard sticky top-0 z-50">
  <div class="max-w-5xl mx-auto px-4 h-16 flex items-center justify-between">

    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 group">
      <span class="text-coral text-xl leading-none select-none">✦</span>
      <span class="font-display text-xl text-charcoal group-hover:text-coral transition-colors duration-200">
        Cocktail Chronicles
      </span>
    </a>

    <!-- Nav + Search -->
    <div class="flex items-center gap-6">
      <nav class="flex items-center gap-1">
        {navLinks.map(({ href, label }) => (
          <a
            href={href}
            class="text-sm font-semibold text-muted hover:text-charcoal hover:bg-mustard/20 px-3 py-1.5 rounded-full transition-colors duration-200"
          >
            {label}
          </a>
        ))}
      </nav>
      <!-- Search widget — wired in Phase 3 -->
      <div id="search"></div>
    </div>

  </div>
</header>
