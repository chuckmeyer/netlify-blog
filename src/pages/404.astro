---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 | Cocktail Chronicles" description="Page not found.">
  <section class="max-w-5xl mx-auto px-4 py-32 text-center">
    <p class="text-6xl mb-6">🍸</p>
    <h1 class="text-4xl font-bold text-stone-50 mb-4">404</h1>
    <p class="text-stone-400 mb-8">This cocktail doesn't exist. Try browsing the menu.</p>
    <a
      href="/blog"
      class="inline-block px-6 py-3 bg-amber-600 hover:bg-amber-500 text-stone-950 font-semibold rounded-lg transition-colors"
    >
      Browse Recipes
    </a>
  </section>
</BaseLayout>
