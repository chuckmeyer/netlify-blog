---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout title="Cocktail Chronicles">

  <!-- Hero -->
  <section class="relative overflow-hidden bg-cream py-24 px-4">
    <!-- Decorative circles -->
    <div class="pointer-events-none absolute -right-24 -top-24 w-96 h-96 rounded-full bg-mustard/25"></div>
    <div class="pointer-events-none absolute -left-16 bottom-0 w-64 h-64 rounded-full bg-coral/15"></div>
    <div class="pointer-events-none absolute right-1/3 bottom-8 w-20 h-20 rounded-full bg-teal/15"></div>

    <div class="relative max-w-5xl mx-auto">
      <p class="text-coral font-bold text-xs tracking-[0.25em] uppercase mb-5">Est. 2025</p>
      <h1 class="font-display text-6xl md:text-8xl text-charcoal leading-none mb-6">
        Cocktail<br />Chronicles
      </h1>
      <p class="text-lg text-muted max-w-md mb-10 leading-relaxed">
        A curated collection of classic and modern cocktail recipes — stirred, shaken, and served with intention.
      </p>
      <a
        href="/blog"
        class="inline-flex items-center gap-2 bg-teal hover:bg-teal-dk text-white font-bold px-8 py-4 rounded-full transition-colors duration-200 text-sm tracking-wide"
      >
        Browse Recipes
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <!-- Latest recipes -->
  {posts.length > 0 && (
    <section class="bg-parchment/30 py-16 px-4">
      <div class="max-w-5xl mx-auto">
        <div class="flex items-center gap-4 mb-10">
          <span class="block w-8 h-1 bg-mustard rounded-full"></span>
          <h2 class="text-xs font-bold uppercase tracking-[0.2em] text-muted">Latest Recipes</h2>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {posts.map((post) => <PostCard post={post} />)}
        </div>
      </div>
    </section>
  )}

</BaseLayout>
