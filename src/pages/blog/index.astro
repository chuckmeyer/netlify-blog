---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Recipes | Cocktail Chronicles" description="Classic and modern cocktail recipes, curated with care.">
  <section class="max-w-5xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold text-stone-50 mb-2">Recipes</h1>
    <p class="text-stone-400 mb-10">
      {posts.length} cocktail{posts.length !== 1 ? 's' : ''} and counting.
    </p>

    {posts.length > 0 ? (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    ) : (
      <p class="text-stone-500 text-center py-20">No recipes yet — check back soon.</p>
    )}
  </section>
</BaseLayout>
