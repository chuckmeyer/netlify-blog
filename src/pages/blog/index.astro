---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Recipes | Cocktail Chronicles" description="Classic and modern cocktail recipes, curated with care.">

  <!-- Page header -->
  <div class="bg-charcoal px-4 py-14">
    <div class="max-w-5xl mx-auto">
      <p class="text-mustard text-xs font-bold tracking-[0.25em] uppercase mb-3">The Collection</p>
      <h1 class="font-display text-5xl text-cream mb-2">Recipes</h1>
      <p class="text-cream/50 text-sm font-medium">
        {posts.length} cocktail{posts.length !== 1 ? 's' : ''} and counting.
      </p>
    </div>
  </div>

  <section class="max-w-5xl mx-auto px-4 py-12">
    {posts.length > 0 ? (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    ) : (
      <div class="text-center py-24">
        <p class="font-display text-3xl text-muted mb-2">Nothing here yet.</p>
        <p class="text-sm text-muted/70">Check back soon.</p>
      </div>
    )}
  </section>

</BaseLayout>
